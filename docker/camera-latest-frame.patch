@@ -0,0 +1,279 @@
+#include "H264Encoder.hpp"
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/videodev2.h>
+#include <poll.h>
+#include <stdexcept>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace camera
+{
+namespace
+{
+constexpr uint32_t kOutputBuffers = 8;
+constexpr uint32_t kCaptureBuffers = 4;
+constexpr size_t kCaptureBufferSize = 1 << 20;
+constexpr std::chrono::milliseconds kEncodeTimeout {500};
+
+int
+xioctl(int fd, unsigned long request, void *arg)
+{
+  int ret;
+  do {
+    ret = ioctl(fd, request, arg);
+  } while (ret == -1 && errno == EINTR);
+  return ret;
+}
+
+std::runtime_error
+error(const std::string &what)
+{
+  return std::runtime_error("H.264 encoder: " + what + ": " + std::strerror(errno));
+}
+
+// Returns whether an Annex B buffer contains a picture slice, and whether one
+// of them is an IDR slice.
+void
+scan_nal_units(const uint8_t *data, size_t size, bool &has_slice, bool &has_idr)
+{
+  has_slice = false;
+  has_idr = false;
+  for (size_t i = 0; i + 3 < size; ++i) {
+    if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+      const uint8_t type = data[i + 3] & 0x1f;
+      has_slice |= type >= 1 && type <= 5;
+      has_idr |= type == 5;
+      i += 2;
+    }
+  }
+}
+} // namespace
+
+H264Encoder::H264Encoder(const Config &config)
+{
+  fd = open(config.device.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0)
+    throw error("cannot open " + config.device);
+
+  try {
+    setControl(V4L2_CID_MPEG_VIDEO_BITRATE, config.bitrate, true);
+    setControl(V4L2_CID_MPEG_VIDEO_H264_PROFILE, V4L2_MPEG_VIDEO_H264_PROFILE_HIGH, false);
+    setControl(V4L2_CID_MPEG_VIDEO_H264_LEVEL, V4L2_MPEG_VIDEO_H264_LEVEL_4_1, false);
+    setControl(V4L2_CID_MPEG_VIDEO_H264_I_PERIOD, config.intra_period, true);
+    // Foxglove can join a running stream only at a keyframe that carries SPS/PPS.
+    setControl(V4L2_CID_MPEG_VIDEO_REPEAT_SEQ_HEADER, 1, true);
+
+    v4l2_format output_format {};
+    output_format.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    output_format.fmt.pix_mp.width = config.width;
+    output_format.fmt.pix_mp.height = config.height;
+    output_format.fmt.pix_mp.pixelformat = config.pixelformat;
+    output_format.fmt.pix_mp.field = V4L2_FIELD_NONE;
+    output_format.fmt.pix_mp.colorspace = config.colorspace;
+    output_format.fmt.pix_mp.num_planes = 1;
+    output_format.fmt.pix_mp.plane_fmt[0].bytesperline = config.stride;
+    if (xioctl(fd, VIDIOC_S_FMT, &output_format) < 0)
+      throw error("cannot set input format");
+    if (output_format.fmt.pix_mp.pixelformat != config.pixelformat ||
+        output_format.fmt.pix_mp.plane_fmt[0].bytesperline != config.stride) {
+      errno = EINVAL;
+      throw error("input format or stride not accepted");
+    }
+
+    v4l2_format capture_format {};
+    capture_format.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    capture_format.fmt.pix_mp.width = config.width;
+    capture_format.fmt.pix_mp.height = config.height;
+    capture_format.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_H264;
+    capture_format.fmt.pix_mp.field = V4L2_FIELD_ANY;
+    capture_format.fmt.pix_mp.colorspace = config.colorspace;
+    capture_format.fmt.pix_mp.num_planes = 1;
+    capture_format.fmt.pix_mp.plane_fmt[0].sizeimage = kCaptureBufferSize;
+    if (xioctl(fd, VIDIOC_S_FMT, &capture_format) < 0)
+      throw error("cannot set H.264 format");
+
+    // The frame rate only feeds the encoder's rate control.
+    v4l2_streamparm parm {};
+    parm.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    parm.parm.output.timeperframe.numerator = 1;
+    parm.parm.output.timeperframe.denominator = config.framerate;
+    if (xioctl(fd, VIDIOC_S_PARM, &parm) < 0)
+      throw error("cannot set frame rate");
+
+    v4l2_requestbuffers output_request {};
+    output_request.count = kOutputBuffers;
+    output_request.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    output_request.memory = V4L2_MEMORY_DMABUF;
+    if (xioctl(fd, VIDIOC_REQBUFS, &output_request) < 0)
+      throw error("cannot request input buffers");
+    output_count = output_request.count;
+
+    v4l2_requestbuffers capture_request {};
+    capture_request.count = kCaptureBuffers;
+    capture_request.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    capture_request.memory = V4L2_MEMORY_MMAP;
+    if (xioctl(fd, VIDIOC_REQBUFS, &capture_request) < 0)
+      throw error("cannot request output buffers");
+
+    for (uint32_t i = 0; i < capture_request.count; ++i) {
+      v4l2_plane plane {};
+      v4l2_buffer buffer {};
+      buffer.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+      buffer.memory = V4L2_MEMORY_MMAP;
+      buffer.index = i;
+      buffer.length = 1;
+      buffer.m.planes = &plane;
+      if (xioctl(fd, VIDIOC_QUERYBUF, &buffer) < 0)
+        throw error("cannot query output buffer");
+      void *data = mmap(nullptr, plane.length, PROT_READ | PROT_WRITE, MAP_SHARED, fd,
+                        plane.m.mem_offset);
+      if (data == MAP_FAILED)
+        throw error("cannot map output buffer");
+      capture_buffers.push_back({data, plane.length});
+      if (xioctl(fd, VIDIOC_QBUF, &buffer) < 0)
+        throw error("cannot queue output buffer");
+    }
+
+    v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    if (xioctl(fd, VIDIOC_STREAMON, &type) < 0)
+      throw error("cannot start input stream");
+    type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    if (xioctl(fd, VIDIOC_STREAMON, &type) < 0)
+      throw error("cannot start output stream");
+  }
+  catch (...) {
+    cleanup();
+    throw;
+  }
+}
+
+H264Encoder::~H264Encoder()
+{
+  cleanup();
+}
+
+void
+H264Encoder::cleanup()
+{
+  if (fd < 0)
+    return;
+  v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  xioctl(fd, VIDIOC_STREAMOFF, &type);
+  type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+  xioctl(fd, VIDIOC_STREAMOFF, &type);
+  for (const CaptureBuffer &buffer : capture_buffers)
+    munmap(buffer.data, buffer.size);
+  capture_buffers.clear();
+  close(fd);
+  fd = -1;
+}
+
+void
+H264Encoder::setControl(uint32_t id, int32_t value, bool required)
+{
+  v4l2_control control {};
+  control.id = id;
+  control.value = value;
+  if (xioctl(fd, VIDIOC_S_CTRL, &control) < 0 && required)
+    throw error("cannot set control " + std::to_string(id));
+}
+
+void
+H264Encoder::forceKeyframe()
+{
+  keyframe_requested = true;
+}
+
+bool
+H264Encoder::encode(int dmabuf_fd, size_t bytesused, size_t length, int64_t timestamp_us,
+                    std::vector<uint8_t> &out, bool &keyframe)
+{
+  if (keyframe_requested) {
+    setControl(V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME, 1, false);
+    keyframe_requested = false;
+  }
+
+  // Keep a stable input index per libcamera dmabuf so the driver can reuse
+  // its import instead of mapping the buffer again for every frame.
+  auto [slot, inserted] = output_index.try_emplace(dmabuf_fd, 0);
+  if (inserted)
+    slot->second = (output_index.size() - 1) % output_count;
+
+  v4l2_plane input_plane {};
+  input_plane.m.fd = dmabuf_fd;
+  input_plane.bytesused = bytesused;
+  input_plane.length = length;
+  v4l2_buffer input {};
+  input.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  input.memory = V4L2_MEMORY_DMABUF;
+  input.index = slot->second;
+  input.field = V4L2_FIELD_NONE;
+  input.length = 1;
+  input.m.planes = &input_plane;
+  input.timestamp.tv_sec = timestamp_us / 1000000;
+  input.timestamp.tv_usec = timestamp_us % 1000000;
+  if (xioctl(fd, VIDIOC_QBUF, &input) < 0)
+    throw error("cannot queue frame");
+
+  bool input_released = false;
+  bool frame_ready = false;
+  const auto deadline = std::chrono::steady_clock::now() + kEncodeTimeout;
+  while (!input_released || !frame_ready) {
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+      deadline - std::chrono::steady_clock::now());
+    if (remaining.count() <= 0)
+      return false;
+    pollfd pfd {fd, static_cast<short>(POLLIN | POLLOUT), 0};
+    if (poll(&pfd, 1, static_cast<int>(remaining.count())) < 0 && errno != EINTR)
+      throw error("poll failed");
+
+    if (!input_released) {
+      v4l2_plane plane {};
+      v4l2_buffer buffer {};
+      buffer.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+      buffer.memory = V4L2_MEMORY_DMABUF;
+      buffer.length = 1;
+      buffer.m.planes = &plane;
+      if (xioctl(fd, VIDIOC_DQBUF, &buffer) == 0)
+        input_released = true;
+      else if (errno != EAGAIN)
+        throw error("cannot dequeue frame");
+    }
+
+    if (!frame_ready) {
+      v4l2_plane plane {};
+      v4l2_buffer buffer {};
+      buffer.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+      buffer.memory = V4L2_MEMORY_MMAP;
+      buffer.length = 1;
+      buffer.m.planes = &plane;
+      if (xioctl(fd, VIDIOC_DQBUF, &buffer) == 0) {
+        const auto *data =
+          static_cast<const uint8_t *>(capture_buffers.at(buffer.index).data) + plane.data_offset;
+        const size_t size = plane.bytesused - plane.data_offset;
+        bool has_slice = false;
+        bool has_idr = false;
+        scan_nal_units(data, size, has_slice, has_idr);
+        pending_headers.insert(pending_headers.end(), data, data + size);
+        if (has_slice) {
+          out.swap(pending_headers);
+          pending_headers.clear();
+          keyframe = has_idr;
+          frame_ready = true;
+        }
+        if (xioctl(fd, VIDIOC_QBUF, &buffer) < 0)
+          throw error("cannot requeue output buffer");
+      }
+      else if (errno != EAGAIN) {
+        throw error("cannot dequeue H.264 data");
+      }
+    }
+  }
+  return true;
+}
+
+} // namespace camera
