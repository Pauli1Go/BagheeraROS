+void
+CameraNode::setupH264(const libcamera::StreamConfiguration &cfg, const std::string &device)
+{
+  uint32_t pixelformat = 0;
+  if (cfg.pixelFormat == libcamera::formats::NV21)
+    pixelformat = V4L2_PIX_FMT_NV21;
+  else if (cfg.pixelFormat == libcamera::formats::NV12)
+    pixelformat = V4L2_PIX_FMT_NV12;
+  else {
+    RCLCPP_ERROR_STREAM(get_logger(), "H.264 needs format NV12 or NV21, not " << cfg.pixelFormat);
+    return;
+  }
+
+  // The encoder reads the chroma plane directly behind the luminance plane.
+  const libcamera::FrameBuffer &buffer = *allocator->buffers(stream).front();
+  const size_t luma_size = static_cast<size_t>(cfg.stride) * cfg.size.height;
+  if (buffer.planes().size() != 2 || buffer.planes()[0].offset != 0 ||
+      buffer.planes()[1].offset != luma_size) {
+    RCLCPP_ERROR_STREAM(get_logger(), "H.264 needs contiguous luminance and chroma planes");
+    return;
+  }
+  h264_frame_size = luma_size + luma_size / 2;
+
+  uint32_t colorspace = V4L2_COLORSPACE_DEFAULT;
+  if (cfg.colorSpace == libcamera::ColorSpace::Sycc)
+    colorspace = V4L2_COLORSPACE_JPEG;
+  else if (cfg.colorSpace == libcamera::ColorSpace::Rec709)
+    colorspace = V4L2_COLORSPACE_REC709;
+  else if (cfg.colorSpace == libcamera::ColorSpace::Smpte170m)
+    colorspace = V4L2_COLORSPACE_SMPTE170M;
+
+  rcl_interfaces::msg::ParameterDescriptor param_descr_ro;
+  param_descr_ro.read_only = true;
+  h264_config = H264Encoder::Config {
+    device,
+    cfg.size.width,
+    cfg.size.height,
+    cfg.stride,
+    pixelformat,
+    colorspace,
+    static_cast<int>(declare_parameter<int>("h264_bitrate", 2000000, param_descr_ro)),
+    static_cast<int>(declare_parameter<int>("h264_intra_period", 15, param_descr_ro)),
+    static_cast<int>(declare_parameter<int>("h264_framerate", 15, param_descr_ro)),
+  };
+  try {
+    h264_encoder = std::make_unique<H264Encoder>(*h264_config);
+    RCLCPP_INFO_STREAM(get_logger(), "H.264 encoder on " << device << " ready");
+  }
+  catch (const std::exception &e) {
+    RCLCPP_ERROR_STREAM(get_logger(), e.what() << "; H.264 stream disabled");
+    h264_config.reset();
+  }
+}
+
+void
+CameraNode::publishH264(const libcamera::FrameBuffer *buffer, const std_msgs::msg::Header &hdr)
+{
+  try {
+    if (!h264_encoder) {
+      // reopen after a failed frame; the next keyframe restarts the stream
+      h264_encoder = std::make_unique<H264Encoder>(*h264_config);
+    }
+    auto msg = std::make_unique<foxglove_msgs::msg::CompressedVideo>();
+    bool keyframe = false;
+    const int64_t timestamp_us = rclcpp::Time(hdr.stamp).nanoseconds() / 1000;
+    if (!h264_encoder->encode(buffer->planes().front().fd.get(), h264_frame_size,
+                              buffer_info[buffer].size, timestamp_us, msg->data, keyframe)) {
+      RCLCPP_WARN_STREAM(get_logger(), "H.264 encoder timed out; reopening it");
+      h264_encoder.reset();
+      return;
+    }
+    msg->timestamp = hdr.stamp;
+    msg->frame_id = hdr.frame_id;
+    msg->format = "h264";
+    pub_h264->publish(std::move(msg));
+  }
+  catch (const std::exception &e) {
+    RCLCPP_ERROR_STREAM_THROTTLE(get_logger(), *get_clock(), 5000, e.what());
+    h264_encoder.reset();
+  }
+}
