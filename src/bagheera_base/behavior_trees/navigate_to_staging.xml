<?xml version="1.0"?>
<!-- Staging-pose navigation for docking (docking_server.navigator_bt_xml).
     Identical to navigate_no_spin.xml except for the precise goal checker:
     the first docking attempt otherwise started a few cm left of the staging
     pose and its curve did not finish before the dock's floor rail. -->
<!-- A blocked path or "collision ahead" is usually temporary in the office
     (people, chairs). Recoveries alternate a quick clear/replan with a 20 s
     wait before clearing and replanning, for up to ~5 minutes (30 retries)
     before the goal is aborted. No spin and no reversing recovery; RPP may
     still align to the path or final heading. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="30" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <!-- Replan every second against the current global costmap. A path
               can remain geometrically valid while a new obstacle appears
               inside it; IsPathValid did not trigger replanning then. -->
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
            error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="precise_goal_checker"
          error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}"/>
      </PipelineSequence>
      <RoundRobin name="WaitingRecovery">
        <Sequence name="ClearAndReplan">
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap" server_timeout="1000"/>
          <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap" server_timeout="1000"/>
          <Wait wait_duration="0.5"/>
        </Sequence>
        <Sequence name="WaitThenReplan">
          <Wait wait_duration="20.0"/>
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap" server_timeout="1000"/>
          <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap" server_timeout="1000"/>
          <Wait wait_duration="0.5"/>
        </Sequence>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
