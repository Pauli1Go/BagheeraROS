<?xml version="1.0"?>
<!-- Four recovery attempts: clear/replan, backup/replan, clear/replan,
     backup/replan. A failed backup falls back to wait/clear before replanning.
     No spin recovery; RPP may still align to the path or final heading. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <!-- Preserve the controller's final-alignment latch. Replanning every
               second called setPlan() and reset it even while turning in place. -->
          <Fallback name="ReplanOnlyWhenNeeded">
            <ReactiveSequence name="KeepValidPath">
              <Inverter>
                <GlobalUpdatedGoal/>
              </Inverter>
              <IsPathValid path="{path}"/>
            </ReactiveSequence>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
              error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"
          error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}"/>
      </PipelineSequence>
      <RoundRobin name="BoundedRecovery">
        <Sequence name="ClearBothCostmaps">
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap" server_timeout="1000"/>
          <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap" server_timeout="1000"/>
          <Wait wait_duration="0.5"/>
        </Sequence>
        <Fallback name="BackUpOrWaitAndClear">
          <BackUp backup_dist="0.20" backup_speed="0.08" time_allowance="6.0"
            disable_collision_checks="false" error_code_id="{backup_error_code}" error_msg="{backup_error_msg}"/>
          <Sequence name="BlockedBackupFallback">
            <Wait wait_duration="1.0"/>
            <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap" server_timeout="1000"/>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap" server_timeout="1000"/>
            <Wait wait_duration="0.5"/>
          </Sequence>
        </Fallback>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
